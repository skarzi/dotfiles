# Debug
yabai -m config debug_output off

# General
yabai -m config layout bsp
yabai -m config window_animation_duration 0.0
yabai -m config window_origin_display focused

# Workspaces (Labels applied to existing spaces)
yabai -m space 1 --label dotfiles 2>/dev/null || true
yabai -m space 2 --label dev0 2>/dev/null || true
yabai -m space 3 --label dev1 2>/dev/null || true
yabai -m space 4 --label dev2 2>/dev/null || true
yabai -m space 5 --label slack 2>/dev/null || true
yabai -m space 6 --label email 2>/dev/null || true
yabai -m space 7 --label comet 2>/dev/null || true
yabai -m space 8 --label spotify 2>/dev/null || true
yabai -m space 9 --label chats 2>/dev/null || true
yabai -m space 10 --label other 2>/dev/null || true

# Windows/panes
# Shadow only floating windows
yabai -m config window_shadow float
# New window spawns to the right if vertical split, or bottom if horizontal one.
yabai -m config window_placement second_child
yabai -m config window_opacity on
yabai -m config active_window_opacity 1.0
yabai -m config normal_window_opacity 0.85
yabai -m config insert_feedback_color 0x0FFFFFFF

# Borders
borders style=round active_color=0xFF51A8B3 inactive_color=0xFFA7AAB0 width=5.0 &

# Apps (manage=off works without Scripting Addition)
yabai -m rule --add app="^(System Settings|System Preferences)$" manage=off
yabai -m rule --add app="^Karabiner-" manage=off
yabai -m rule --add app="^Finder$" manage=off
yabai -m rule --add app="^Disk Utility$" manage=off
yabai -m rule --add app="^System Information$" manage=off
yabai -m rule --add app="^Activity Monitor$" manage=off
yabai -m rule --add app="^Zwift(App)?$" manage=off
yabai -m rule --add app="^NordVPN$" manage=off
yabai -m rule --add app="^Loom$" manage=off
yabai -m rule --add app="^Docker\s" manage=off
yabai -m rule --add app="^Path Finder$" manage=off
yabai -m rule --add app="^AWS VPN Client$" manage=off
