#!/usr/bin/env bash
# shellcheck shell=bash

set -euo pipefail

EXISTING_CONFIG="$(cat)"

BASE_CONFIG=$(
  cat <<EOF
{
  "artifactReviewPolicy": "agent-decides",
  "notifications": true,
  "permissions": {
    "allow": [
      "command(find)",
      "command(head)",
      "command(ls)",
      "command(tail)",
      "command(grep)",
      "command(gh pr diff)",
      "command(gh pr list)",
      "command(gh pr status)",
      "command(gh pr view)",
      "command(git diff)",
      "command(git status)",
      "mcp(MCP_DOCKER/get-library-docs)",
      "mcp(MCP_DOCKER/perplexity_ask)",
      "mcp(MCP_DOCKER/perplexity_reason)",
      "mcp(MCP_DOCKER/perplexity_research)",
      "mcp(MCP_DOCKER/resolve-library-id)",
      "mcp(context-mode/*)"
    ]
  },
  "showFeedbackSurvey": false,
  "statusLine": {
    "type": "command",
    "command": "{{ .chezmoi.homeDir }}/.gemini/antigravity-cli/statusline.sh"
  },
  "toolPermission": "request-review"
}
EOF
)

if [[ -z "${EXISTING_CONFIG}" ]]; then
  echo "${BASE_CONFIG}"
else
  jq -n \
    --argjson existing "${EXISTING_CONFIG}" \
    --argjson base "${BASE_CONFIG}" \
    '($existing * $base) | .permissions.allow = (($existing.permissions.allow // []) + ($base.permissions.allow // []) | unique)'
fi
