# shellcheck shell=bash
# If not running interactively, don't do anything.
case $- in
*i*) ;;
*) return ;;
esac

# INITIALIZATION AND SHELL OPTIONS
# Vi mode for command line editing.
set -o vi

export LANG="en_US.UTF-8"

# Bash history
# Don't put duplicate lines or lines starting with space in the history.
HISTCONTROL="ignoreboth"
# Immediately append to the history file, don't overwrite it.
shopt -s histappend
export HISTSIZE="2000"
export HISTFILESIZE="10000"
# Share history between all bash sessions using a `PROMPT_COMMAND` hook.
# For plain sharing without session-first ordering, use:
# `PROMPT_COMMAND="history -a; history -c; history -r"`
if [[ -r "${HOME}/dotfiles/bin/history.sh" ]]; then
  # shellcheck source=/dev/null  # External file, may not be accessible
  source "${HOME}/dotfiles/bin/history.sh"
fi

# Check the window size after each command and update it, if necessary.
shopt -s checkwinsize

# If set, the pattern "**" used in a pathname expansion context will
# match all files and zero or more directories and subdirectories.
# shopt -s globstar
# Editor and pager configuration
export PAGER="less"
export EDITOR="nvim"
export VISUAL="nvim"

# Enable colored GCC warnings and errors.
export GCC_COLORS="error=01;31:warning=01;35:note=01;36:caret=01;32:locus=01:quote=01"
# Use bat for man pages with proper formatting.
export MANPAGER="sh -c 'awk '\''{ gsub(/\x1B\[[0-9;]*m/, \"\", \$0); gsub(/.\x08/, \"\", \$0); print }'\'' | bat --theme=TwoDark -p -lman'"

# GPG
# Point pinentry at this terminal.
export GPG_TTY="$(tty)"

# BASH UTILITIES
# Add a directory to `${PATH}` if it exists and is not already there.
# Arguments:
#   ${1}: Directory path to add
#   ${2}: If `true`, removes the directory from `${PATH}` first (if present)
#   and then prepends it, ensuring it is at the front (default: `false`).
# Returns:
#   `0` if directory was added or already exists in `${PATH}`
#   `1` if directory doesn't exist
add_to_path() {
  local dir="${1}"
  local should_force_update="${2:-false}"

  if [[ ! -d "${dir}" ]]; then
    return 1
  fi
  if [[ "${should_force_update}" == "true" ]]; then
    PATH=":${PATH}:"
    PATH="${PATH//:${dir}:/:}"
    PATH="${PATH#:}"
    PATH="${PATH%:}"
  fi
  if [[ ":${PATH}:" != *":${dir}:"* ]]; then
    PATH="${dir}:${PATH}"
  fi
  return 0
}

# PACKAGE MANAGER
export HOMEBREW_BUNDLE_FILE_GLOBAL="${HOME}/.config/homebrew/Brewfile"
export HOMEBREW_PREFIX="$(brew --prefix)"
add_to_path "${HOMEBREW_PREFIX}/bin" "true"
add_to_path "${HOMEBREW_PREFIX}/sbin" "true"

# SHELL ENHANCEMENTS
# BASH completion
# User dirs, searched before Homebrew's own completions. Ours first.
# On Linux, /etc/bash.bashrc has usually loaded bash-completion already.
export BASH_COMPLETION_USER_DIR="${HOME}/.bash_completion.d:${XDG_DATA_HOME:-${HOME}/.local/share}/bash-completion"
if ! shopt -oq posix && [[ -z "${BASH_COMPLETION_VERSINFO-}" ]]; then
  if [[ -s "${HOMEBREW_PREFIX}/etc/profile.d/bash_completion.sh" ]]; then
    # shellcheck source=/dev/null  # System file, may not be accessible
    source "${HOMEBREW_PREFIX}/etc/profile.d/bash_completion.sh"
  elif [[ -f /usr/share/bash-completion/bash_completion ]]; then
    # shellcheck source=/dev/null  # System file, may not be accessible
    source /usr/share/bash-completion/bash_completion
  elif [[ -f /etc/bash_completion ]]; then
    # shellcheck source=/dev/null  # System file, may not be accessible
    source /etc/bash_completion
  fi
fi

# TOOLS
# mise
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate bash)"
fi

# uv
add_to_path "${HOME}/.local/bin"

{{- if eq .env "personal" }}
# Android Development
export ANDROID_HOME="${HOME}/Android/Sdk"
export JAVA_HOME="${HOMEBREW_PREFIX}/opt/openjdk"
if [[ -d "${ANDROID_HOME}" ]]; then
  add_to_path "${JAVA_HOME}/bin"
  add_to_path "${ANDROID_HOME}/platform-tools"
  add_to_path "${ANDROID_HOME}/platform-tools"
fi
add_to_path "${HOMEBREW_PREFIX}/gradle/gradle-4.10.2/bin"
{{- end }}

# fzf
if command -v fzf >/dev/null 2>&1; then
  eval "$(fzf --bash)"
fi

# Docker
export DOCKER_CONFIG="${DOCKER_CONFIG:-${HOME}/.docker}"
export DOCKER_BUILDKIT=1
export COMPOSE_DOCKER_CLI_BUILD=1

# OrbStack
# shellcheck source=/dev/null  # External file, may not be accessible
source "${HOME}/.orbstack/shell/init.bash" 2>/dev/null || :

# colima
# Uncomment to use Colima Docker socket.
# export DOCKER_HOST="$(colima status --json | jq --raw-output .docker_socket)"
# export DOCKER_HOST="unix://${HOME}/.colima/default/docker.sock"

# TERMINAL
# NOTE: Use "rxvt-unicode-256color" for urxvt.
export TERM="xterm-256color"
export CLICOLOR=1
export ALACRITTY_HOME="${HOME}/alacritty"

# starship
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init bash)"
fi

# ALIAS LOADING
if [[ -f "${HOME}/.bash_aliases" ]]; then
  # shellcheck source=/dev/null  # External file, may not be accessible
  source "${HOME}/.bash_aliases"
fi

{{- if eq .env "work" }}
{{ include ".encrypted_data/work/bashrc.sh.age" | decrypt }}
{{- end }}

