#!/usr/bin/env bash
# shellcheck shell=bash

set -euo pipefail

EXISTING_CONFIG="$(cat)"

BASE_CONFIG=$(
  cat <<EOF
{
  "editorMode": "vim",
  "effortLevel": "xhigh",
  "model": "sonnet",
  "statusLine": {
    "type": "command",
    "command": "npx -y ccstatusline@latest",
    "hideVimModeIndicator": true,
    "padding": 0
  },
  "tui": "fullscreen"
}
EOF
)

if [[ -z "${EXISTING_CONFIG}" ]]; then
  echo "${BASE_CONFIG}"
else
  jq -n \
    --argjson existing "${EXISTING_CONFIG}" \
    --argjson base "${BASE_CONFIG}" \
    '$existing * $base'
fi
